#!/usr/bin/env python3
from __future__ import annotations

import argparse
import re
import shlex
import subprocess
import sys
import tempfile
from dataclasses import dataclass
from pathlib import Path

from framework_source import FrameworkSourceError, validate_framework_sources

SUPPORTED_SEMANTICS = {
    "cf",
    "stable",
    "admissible",
    "complete",
    "preferred",
    "grounded",
    "naive",
    "semi-stable",
    "stage",
    "ideal",
    "eager",
}
ALL_SEMANTICS = sorted(SUPPORTED_SEMANTICS)

# Four clean algebras + two polarity-dual aliases (godel_low->bottleneck_cost,
# tropical_high->arctic), kept as thin #include shims under semiring/, plus the
# standalone Lukasiewicz algebra (no polarity variants).
SEMIRING_VARIANTS = {
    "godel",            # (max, min)  strength / fuzzy
    "tropical",         # (min, +)    cost / shortest path
    "arctic",           # (max, +)    strength / reward accumulation
    "bottleneck_cost",  # (min, max)  cost / worst-case
    "lukasiewicz",      # (max, bounded sum) strength / erosion; standalone family
    "godel_low",        # alias -> bottleneck_cost
    "tropical_high",    # alias -> arctic
}
SEMIRING_FAMILIES = {
    "godel": {"higher": "godel", "lower": "bottleneck_cost", "default": "higher"},
    "tropical": {"higher": "arctic", "lower": "tropical", "default": "lower"},
}
SHOW_FILTERS = {"projection": "projection.lp", "standard": "standard.lp"}
DEFAULT_POLICIES = {
    "aba": "aba.lp",
    "neutral": "neutral.lp",
}

OBJECTIVES = {
    "sum-min": {"family": "sum", "optimization": "minimize.lp"},
    "sum-max": {"family": "sum", "optimization": "maximize.lp"},
    "max-min": {"family": "max", "optimization": "minimize.lp"},
    "max-max": {"family": "max", "optimization": "maximize.lp"},
    "min-min": {"family": "min", "optimization": "minimize.lp"},
    "min-max": {"family": "min", "optimization": "maximize.lp"},
}
CANONICAL_PRESETS = {("sum", "ub"), ("max", "ub"), ("min", "lb")}

# Higher-order semantics: enumerate a simple candidate family, then apply the
# defining set comparison separately inside each fixed discard reduct.  The
# discard witness is existentially forgotten only afterwards.
POST_FILTER_SEMANTICS = {
    "preferred": "admissible",
    "grounded": "complete",
    "naive": "cf",
    "semi-stable": "complete",
    "stage": "cf",
    "ideal": "admissible",
    "eager": "complete",
}
POST_FILTER_MODULE = {
    "preferred": "subset_maximal_filter.lp",
    "grounded": "subset_minimal_filter.lp",
    "naive": "subset_maximal_filter.lp",
    "semi-stable": "range_maximal_filter.lp",
    "stage": "range_maximal_filter.lp",
    "ideal": "ideal_filter.lp",
    "eager": "eager_filter.lp",
}

# Range maximisation needs S union S+ in the candidate output.  Keeping this
# projection in a private module avoids exposing an implementation predicate in
# ordinary complete/conflict-free runs.
POST_FILTER_AUX = {
    "semi-stable": "_range.lp",
    "stage": "_range.lp",
    "eager": "_range.lp",
}

# semantics whose module name matches the CLI name need no entry here.
SEMANTIC_MODULE: dict[str, str] = {}


@dataclass(frozen=True)
class Model:
    text: str
    extension: frozenset[str]
    discarded: frozenset[str]
    semantic_range: frozenset[str]
    optimization_text: str | None
    optimization_key: tuple[int, ...] | None


def project_root() -> Path:
    return Path(__file__).resolve().parent.parent


VIOLATION_PATTERN = re.compile(r"violation\(([a-z_]+),(.+?)\)(?=\s|$)")

EXPLAIN = {
    "not_flat": "wABA is defined for FLAT ABA: an assumption may not be the head of a rule",
    "cyclic": "wABA is defined for WELL-FOUNDED frameworks: rule dependencies must be acyclic, "
              "or a derived atom's weight has no unique least fixpoint",
    "multi_weight": "weight/2 must be a partial FUNCTION: two weights for one atom split a "
                    "single conflict into several independently discardable attacks",
    "missing_contrary": "contrary/2 must be TOTAL on assumptions: every assumption needs "
                        "exactly one contrary",
    "multi_contrary": "contrary/2 must be FUNCTIONAL: an assumption may have only one "
                      "contrary",
    "multi_head": "each rule identifier must have exactly ONE head",
    "orphan_body": "every body/2 fact must name a rule identifier declared by head/2",
    "not_a_number": "a non-integral weight is dropped by the monoid aggregates, so its attack "
                    "would cost nothing and be discardable at any budget",
    "negative": "weights must be nonnegative",
    "off_grid": "outside Lukasiewicz's carrier [0, k], where the bounded sum is not associative",
    "not_finite": "the wrapper surface normalises authored weights to finite integers; compose "
                  "the raw clingo modules for #sup/#inf leaf weights",
}


def validate_framework(framework: Path, semiring_module: str, luk_k: int | None) -> None:
    """
    Enforce the data-only source boundary, then run the mathematical pre-flight program.

    The first pass accepts a conservative source language rather than trying to recognise
    arbitrary ASP. The second lets clingo ground the accepted facts with validate.lp, which
    checks the framework conditions and reports their exact offenders without any search.
    """
    # First enforce the source boundary assumed by the encoding: the five framework
    # predicates are ground data facts, and a framework cannot define or constrain runtime
    # predicates.  validate.lp checks the mathematical values of those facts afterwards.
    try:
        validate_framework_sources(framework, project_root())
    except FrameworkSourceError as exc:
        raise SystemExit(
            "unsafe framework source:\n"
            f"  {exc}\n\n"
            "The supported wrapper accepts ground data facts, comments, #const, and #include. "
            "Use head/2 and body/2 facts for ABA rules; use direct clingo composition for a "
            "general ASP program."
        ) from exc

    # finite_only=1: the wrapper normalises authored weights to finite nonnegative integers.
    # A sentinel weight is legal MATHEMATICS for four of the five algebras -- it is a surface
    # decision, which is why validate.lp leaves it off by default for raw composition.
    args = ["clingo", "--warn=none", "-n", "1", "--outf=0", "-c", "finite_only=1",
            str(project_root() / "validate.lp"), str(framework)]
    if "lukasiewicz" in semiring_module:
        # The module carries `#const k = 1000`, so the carrier applies whether or not --luk-k was
        # given. Gating the check on the FLAG meant omitting it skipped the check while the
        # algebra stayed bounded -- a framework weighted 5000 then reported a strength-4000
        # attack where the algebra says 0, and silently lost a stable extension.
        args += ["-c", f"k={luk_k if luk_k is not None else 1000}"]

    proc = subprocess.run(args, capture_output=True, text=True)
    if proc.returncode not in (0, 10, 20, 30):
        raise SystemExit(f"could not validate the framework:\n{proc.stderr.strip()}")
    # The data-only parser has already excluded authored constraints. UNSATISFIABLE here is
    # therefore a validator failure, never evidence that a framework is well formed.
    if "UNSATISFIABLE" in proc.stdout:
        raise SystemExit(
            "could not validate this framework: the pre-flight program was unexpectedly "
            "unsatisfiable; compose the raw clingo modules directly only if you intend to "
            "leave the supported data boundary"
        )

    seen: list[tuple[str, str]] = []
    for match in VIOLATION_PATTERN.finditer(proc.stdout):
        kind, atom = match.group(1), match.group(2).strip()
        if (kind, atom) not in seen:
            seen.append((kind, atom))
    if not seen:
        return

    by_kind: dict[str, list[str]] = {}
    for kind, atom in seen:
        by_kind.setdefault(kind, []).append(atom)
    lines = []
    for kind, atoms in by_kind.items():
        shown = ", ".join(sorted(atoms)[:6])
        more = "" if len(atoms) <= 6 else f" (+{len(atoms) - 6} more)"
        lines.append(f"  {EXPLAIN.get(kind, kind)}\n    {shown}{more}")
    raise SystemExit(
        "this is not a well-formed wABA framework:\n" + "\n".join(lines)
        + "\n\nThese are preconditions of the definition, checked before solving. Compose the "
          "raw clingo modules directly if you want them unchecked."
    )


def shell_join(parts: list[str]) -> str:
    return shlex.join(parts)


def parse_optimization(line: str) -> tuple[int, ...]:
    _, values = line.split(":", 1)
    return tuple(int(value) for value in values.strip().split())


def split_model_atoms(model_text: str) -> list[str]:
    """Split clingo's textual model without breaking nested terms or quoted strings."""
    atoms: list[str] = []
    start: int | None = None
    depth = 0
    quote: str | None = None
    escaped = False

    for index, char in enumerate(model_text):
        if start is None:
            if char.isspace():
                continue
            start = index

        if quote is not None:
            if escaped:
                escaped = False
            elif char == "\\":
                escaped = True
            elif char == quote:
                quote = None
            continue

        if char in {'"', "'"}:
            quote = char
        elif char in "([{":
            depth += 1
        elif char in ")]}" and depth > 0:
            depth -= 1
        elif char.isspace() and depth == 0:
            atoms.append(model_text[start:index])
            start = None

    if start is not None:
        atoms.append(model_text[start:])
    return atoms


def predicate_argument(atom: str, predicate: str) -> str | None:
    prefix = f"{predicate}("
    if atom.startswith(prefix) and atom.endswith(")"):
        return atom[len(prefix):-1]
    return None


def parse_models(stdout: str) -> list[Model]:
    lines = stdout.splitlines()
    models: list[Model] = []
    index = 0

    while index < len(lines):
        if not lines[index].startswith("Answer:"):
            index += 1
            continue

        if index + 1 >= len(lines):
            break

        model_text = lines[index + 1].strip()
        opt_text = None
        opt_key = None
        if index + 2 < len(lines) and lines[index + 2].startswith("Optimization:"):
            opt_text = lines[index + 2].strip()
            opt_key = parse_optimization(opt_text)
            index += 1

        atoms = split_model_atoms(model_text)
        # semantic_range/1 is an internal receipt needed only by range-based
        # post-filters.  Retain it structurally, but do not leak it through the
        # user's selected output filter.
        visible_atoms = [
            atom for atom in atoms
            if predicate_argument(atom, "semantic_range") is None
        ]
        models.append(
            Model(
                text=" ".join(visible_atoms),
                extension=frozenset(
                    value for atom in atoms
                    if (value := predicate_argument(atom, "in")) is not None
                ),
                discarded=frozenset(
                    value for atom in atoms
                    if (value := predicate_argument(atom, "discarded_attack")) is not None
                ),
                semantic_range=frozenset(
                    value for atom in atoms
                    if (value := predicate_argument(atom, "semantic_range")) is not None
                ),
                optimization_text=opt_text,
                optimization_key=opt_key,
            )
        )
        index += 2

    return models


def dedupe_candidate_witnesses(models: list[Model]) -> list[Model]:
    """Remove duplicate solver models while retaining distinct reduced frameworks."""
    seen: set[tuple[frozenset[str], frozenset[str], tuple[int, ...] | None]] = set()
    result: list[Model] = []
    for model in models:
        key = (model.extension, model.discarded, model.optimization_key)
        if key in seen:
            continue
        seen.add(key)
        result.append(model)
    return result


def dedupe_extensions(models: list[Model]) -> list[Model]:
    """Existentially forget discard witnesses, retaining one receipt per extension."""
    seen: set[frozenset[str]] = set()
    result: list[Model] = []
    for model in models:
        if model.extension in seen:
            continue
        seen.add(model.extension)
        result.append(model)
    return result


def keep_optimal(models: list[Model]) -> list[Model]:
    if not models:
        return []
    missing = [model for model in models if model.optimization_key is None]
    if missing:
        raise RuntimeError("missing optimization data for candidate models")
    best = min(model.optimization_key for model in models if model.optimization_key is not None)
    return [model for model in models if model.optimization_key == best]


def print_filtered_models(models: list[Model], semantics: str, candidate_semantics: str, optimum: bool) -> int:
    if not models:
        print("UNSATISFIABLE")
        return 0

    print(f"% filtered {len(models)} {semantics} extension(s) from {candidate_semantics} candidates")
    for index, model in enumerate(models, start=1):
        print(f"Answer: {index}")
        print(model.text)
        if model.optimization_text is not None:
            print(model.optimization_text)
    print("OPTIMUM FOUND" if optimum else "SATISFIABLE")
    print()
    print(f"Models       : {len(models)}")
    if optimum and models[0].optimization_text is not None:
        print(f"Optimization : {' '.join(str(value) for value in models[0].optimization_key or ())}")
    return 0


def asp_filter_models(models: list[Model], filter_module: str) -> list[Model]:
    """Apply an exact relational filter inside each fixed discarded-attack reduct."""
    if not models:
        return []

    root = project_root()
    atoms = sorted({atom for model in models for atom in model.extension})
    atom_ids = {atom: index + 1 for index, atom in enumerate(atoms)}

    with tempfile.NamedTemporaryFile("w", suffix=".lp", delete=False) as handle:
        facts_path = Path(handle.name)
        for index, model in enumerate(models, start=1):
            handle.write(f"candidate({index}).\n")
            for atom in sorted(model.extension):
                handle.write(f"member({index},{atom_ids[atom]}).\n")
            for atom in sorted(model.semantic_range):
                # Range atoms come from the same assumption domain as extension
                # atoms.  A defeated-only assumption may occur in no extension,
                # so assign an id lazily rather than assuming it is in atom_ids.
                if atom not in atom_ids:
                    atom_ids[atom] = len(atom_ids) + 1
                handle.write(f"range_member({index},{atom_ids[atom]}).\n")
            for attack in sorted(model.discarded):
                handle.write(f"discarded_member({index},{attack}).\n")

    command = [
        "clingo",
        "--warn=no-atom-undefined",
        "-n",
        "0",
        str(root / "semantics" / filter_module),
        str(facts_path),
    ]
    try:
        completed = subprocess.run(command, capture_output=True, text=True)
    finally:
        facts_path.unlink(missing_ok=True)

    if completed.returncode not in {0, 10, 20, 30}:
        raise RuntimeError(completed.stderr or completed.stdout or f"{filter_module} ASP filter failed")

    keep_ids = {int(match) for match in re.findall(r"keep\((\d+)\)", completed.stdout)}
    kept = [model for index, model in enumerate(models, start=1) if index in keep_ids]
    return kept


def build_clingo_command(
    args: argparse.Namespace,
    semantic_name: str,
    opt_mode: str,
    *,
    project_extensions: bool,
    auxiliary_semantics: str | None = None,
) -> list[str]:
    root = project_root()
    framework = Path(args.framework).expanduser().resolve()
    command = [
        "clingo",
        "--warn=no-atom-undefined",
        "-n",
        "0",
        "--opt-mode=" + opt_mode,
        *(["--project"] if project_extensions else []),
        # Suppress improving-but-nonoptimal search witnesses.  With the explicit
        # #project in/1 and out/1 declarations in every direct semantics module,
        # quiet=1 prints each final optimal extension once while retaining one shown
        # discarded_attack receipt for it.
        *(["--quiet=1"] if opt_mode == "optN" else []),
        "-c",
        f"beta={args._effective_beta}",
        *(
            ["-c", f"k={args._effective_luk_k}"]
            if getattr(args, "_effective_luk_k", None) is not None else []
        ),
        str(root / "core" / "base.lp"),
        str(root / "semiring" / f"{args._semiring_module}.lp"),
    ]

    if args._default_policy_module is not None:
        command.append(str(root / "defaults" / args._default_policy_module))

    if args._monoid_module is not None:
        command.append(str(root / "monoid" / args._monoid_module))
    if args._optimize_module is not None:
        command.append(str(root / "optimize" / args._optimize_module))

    command.extend(
        [
            str(root / "constraint" / args._constraint_module),
            str(root / "filter" / SHOW_FILTERS[args.show]),
            str(root / "semantics" / f"{SEMANTIC_MODULE.get(semantic_name, semantic_name)}.lp"),
        ]
    )
    if auxiliary_semantics is not None:
        command.append(str(root / "semantics" / auxiliary_semantics))
    command.append(str(framework))
    return command


def validate_args(args: argparse.Namespace) -> None:
    if args.semiring_family is not None and args.semiring is not None:
        raise SystemExit("use either --semiring or --semiring-family/--polarity, not both")
    if args.polarity is not None and args.semiring_family is None:
        raise SystemExit("--polarity requires --semiring-family")
    if args.aba_recovery and (args.objective is not None or args.beta is not None or args.budget_mode != "none"
                              or args.default_policy is not None):
        raise SystemExit("--aba-recovery cannot be combined with --objective, --budget-mode, --beta,"
                         " or --default-policy (recovery pins neutral + no_discard)")

    if args.semiring_family is not None:
        family = SEMIRING_FAMILIES[args.semiring_family]
        polarity = args.polarity or family["default"]
        args._semiring_module = family[polarity]
    else:
        if args.semiring is None:
            args.semiring = "godel"
        if args.semiring not in SEMIRING_VARIANTS:
            raise SystemExit(f"unknown semiring: {args.semiring}")
        args._semiring_module = args.semiring

    if args._semiring_module == "lukasiewicz" and args.luk_k is not None and args.luk_k <= 0:
        raise SystemExit("--luk-k must be a positive integer")
    # Always pass the effective carrier bound. Otherwise an authored `#const k=...` can
    # collide with the module default or make the solve disagree with the pre-flight, which
    # already checks against 1000 when --luk-k is omitted. This also matches the browser.
    args._effective_luk_k = (
        args.luk_k if args.luk_k is not None else 1000
    ) if args._semiring_module == "lukasiewicz" else None

    if args.default_policy is None:
        args.default_policy = "neutral"
    args._default_policy_module = DEFAULT_POLICIES[args.default_policy]

    if args.aba_recovery:
        args._effective_beta = 0
        args._constraint_module = "no_discard.lp"
        args._monoid_module = None
        args._optimize_module = None
    elif args.budget_mode == "none":
        if args.objective is not None:
            raise SystemExit("objective requires --budget-mode ub or --budget-mode lb")
        if args.beta is not None:
            raise SystemExit("beta is only valid when a budget mode is enabled")
        args._effective_beta = 0
        args._constraint_module = "no_discard.lp"
        args._monoid_module = None
        args._optimize_module = None
    else:
        if args.objective is None:
            raise SystemExit("budgeted runs require --objective")
        if args.beta is None:
            raise SystemExit("budgeted runs require --beta")
        objective = OBJECTIVES[args.objective]
        if (objective["family"], args.budget_mode) not in CANONICAL_PRESETS:
            raise SystemExit(
                "the supported wrapper surface only exposes sum/max with ub and min with lb; "
                "use raw clingo modules for other pairings"
            )
        args._effective_beta = args.beta
        args._constraint_module = f"{args.budget_mode}.lp"
        args._monoid_module = f"{objective['family']}.lp"
        args._optimize_module = objective["optimization"]



def run_direct(args: argparse.Namespace) -> int:
    # `--objective` selects the aggregation monoid as well as an optional ranking
    # direction.  The beta-sigma semantics itself is the existential union over every
    # affordable reduct, so enumeration remains the default; ranking is an explicit,
    # subsequent result filter requested with `--opt-mode optN`.
    opt_mode = args.opt_mode

    command = build_clingo_command(
        args, args.semantics, opt_mode, project_extensions=True
    )
    print(shell_join(command), file=sys.stderr)
    if args.print_command:
        print(shell_join(command))
        return 0

    completed = subprocess.run(command)
    return 0 if completed.returncode in {0, 10, 20, 30} else completed.returncode


def run_post_filtered(args: argparse.Namespace) -> int:
    candidate_semantics = POST_FILTER_SEMANTICS[args.semantics]
    requested_opt_mode = args.opt_mode
    # Higher-order semantics require every affordable reduct before they can apply
    # their ordinary subset/range relation inside that reduct. `enum` records each
    # witness's objective value without pruning; requested global optimization happens later.
    candidate_opt_mode = "enum" if requested_opt_mode == "optN" else "ignore"
    command = build_clingo_command(
        args,
        candidate_semantics,
        candidate_opt_mode,
        project_extensions=False,
        auxiliary_semantics=POST_FILTER_AUX.get(args.semantics),
    )
    print(shell_join(command), file=sys.stderr)
    print(
        f"% post-filtering {candidate_semantics} candidates into {args.semantics}",
        file=sys.stderr,
    )
    if args.print_command:
        # This semantics needs TWO solver calls: the printed command is only the first,
        # which enumerates the CANDIDATES. Pasting it back returns those candidates, not
        # the subset-extremal ones this run reports. Say so on stdout, where the command
        # goes, rather than only on stderr -- a caller capturing stdout would otherwise
        # get a command that silently answers a different question.
        print(
            f"% NOTE: {args.semantics} is computed in two passes. The command below is pass 1"
            f" and yields the {candidate_semantics} CANDIDATES; pass 2 filters them with"
            f" semantics/{POST_FILTER_MODULE[args.semantics]} over a generated facts file and is"
            f" not reproducible as a single command."
        )
        print(shell_join(command))
        return 0

    completed = subprocess.run(command, capture_output=True, text=True)
    if completed.stderr:
        filtered_stderr = "\n".join(
            line
            for line in completed.stderr.splitlines()
            if "opt-mode=enum: No bound given, optimize statement ignored." not in line
        )
        if filtered_stderr:
            print(filtered_stderr, file=sys.stderr, end="" if filtered_stderr.endswith("\n") else "\n")
    if completed.returncode not in {0, 10, 20, 30}:
        if completed.stdout:
            print(completed.stdout, end="")
        return completed.returncode

    models = dedupe_candidate_witnesses(parse_models(completed.stdout))
    models = asp_filter_models(models, POST_FILTER_MODULE[args.semantics])
    optimum = False

    if args.objective is not None and requested_opt_mode == "optN":
        models = keep_optimal(models)
        optimum = True

    # beta-sigma quantifies existentially over D. Once ordinary sigma has been
    # computed per reduct, equal assumption sets are one extension; retain the
    # first model as a concrete discard receipt.
    models = dedupe_extensions(models)

    return print_filtered_models(models, args.semantics, candidate_semantics, optimum)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="waba")
    subparsers = parser.add_subparsers(dest="command", required=True)

    run = subparsers.add_parser("run", help="run the supported WABA CLI")
    run.add_argument("--framework", required=True, help="path to the framework file")
    run.add_argument("--semiring", choices=sorted(SEMIRING_VARIANTS))
    run.add_argument("--semiring-family", choices=sorted(SEMIRING_FAMILIES))
    run.add_argument("--polarity", choices=["higher", "lower"])
    run.add_argument("--default-policy", choices=sorted(DEFAULT_POLICIES))
    run.add_argument(
        "--aba-recovery",
        action="store_true",
        help="recover classical ABA by loading the exact no-discard constraint",
    )
    run.add_argument("--semantics", default="stable", choices=ALL_SEMANTICS)
    run.add_argument("--objective", choices=sorted(OBJECTIVES))
    run.add_argument("--budget-mode", default="none", choices=["none", "ub", "lb"])
    run.add_argument("--beta", type=int)
    run.add_argument("--show", default="projection", choices=sorted(SHOW_FILTERS))
    run.add_argument(
        "--opt-mode",
        choices=["ignore", "optN"],
        default="ignore",
        help="enumerate the full beta-sigma union by default; use optN to retain only "
             "globally objective-optimal results",
    )
    run.add_argument(
        "--luk-k", type=int, default=None, metavar="K",
        help="Lukasiewicz bound k (default 1000). Its conjunction is max(0, a+b-k), so with "
             "the default an ordinary small-integer derivation erodes to 0; set k near the "
             "scale of your weights. Ignored by the other algebras.",
    )
    run.add_argument("--print-command", action="store_true")
    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    if args.command != "run":
        parser.error("unsupported command")

    framework = Path(args.framework).expanduser().resolve()
    if not framework.exists():
        raise SystemExit(f"framework not found: {framework}")

    validate_args(args)
    validate_framework(framework, args._semiring_module, getattr(args, 'luk_k', None))

    if args.semantics in POST_FILTER_SEMANTICS:
        return run_post_filtered(args)
    return run_direct(args)


if __name__ == "__main__":
    raise SystemExit(main())
