# Default to private.
# Keep only the thin wrapper, the mature logic-programming modules,
# and the curated example surface visible.
*
!*/
!/.gitignore

# Public wrapper + tooling
!bin/waba
!bin/sync-playground.mjs
!bin/framework_source.py

# Shared declarative source-boundary policy used by the CLI and browser bundle.
!/input-policy.json

# Public README
!/README.md

# Public logic-programming surface
!core/
!core/base.lp
!defaults/
!defaults/aba.lp
!defaults/base.lp
!defaults/legacy.lp
!defaults/neutral.lp
!filter/
!filter/projection.lp
!filter/standard.lp
!constraint/
!constraint/lb.lp
!constraint/no_discard.lp
!constraint/ub.lp
!monoid/
!monoid/max.lp
!monoid/min.lp
!monoid/sum.lp
!optimize/
!optimize/maximize.lp
!optimize/minimize.lp
!semantics/
!semantics/admissible.lp
!semantics/admissible_budgeted.lp
!semantics/admissible_dunne.lp
!semantics/complete_dunne.lp
!semantics/cf.lp
!semantics/complete.lp
!semantics/grounded.lp
!semantics/stable.lp
!semantics/subset_maximal_filter.lp
!semantics/subset_minimal_filter.lp
!semantics/range_maximal_filter.lp
!semantics/ideal_filter.lp
!semantics/eager_filter.lp
!semantics/_range.lp
!semiring/
!semiring/_phase.lp
!semiring/_idempotent.lp
!semiring/_additive.lp
!semiring/arctic.lp
!semiring/bottleneck_cost.lp
!semiring/godel.lp
!semiring/godel_low.lp
!semiring/lukasiewicz.lp
!semiring/tropical.lp
!semiring/tropical_high.lp

# Pre-flight framework validation + the optional support-set fold. Both are referenced by
# tracked files -- bin/waba shells out to validate.lp, and test/regression.sh needs both -- so
# omitting them from this allow-list leaves HEAD unrunnable, which is how they were missed.
!/validate.lp
!/setsupport.lp

# Public regression tests
!test/
!test/_z3venv.py
!test/beta_sigma_oracle.py
!test/finite_aba_oracle.py
!test/extended_semantics.py
!test/input_boundary.py
!test/regression.sh
!test/semantics_proofs.py
!test/unified_beta_sigma.sh

# Public curated example surface
!examples/
!examples/README.md
!examples/aspartix_test/
!examples/aspartix_test/simple_attack.lp
!examples/practical_deliberation/
!examples/practical_deliberation/practical_deliberation.lp
!examples/scientific_theory/
!examples/scientific_theory/scientific_theory.lp
!examples/reference/
!examples/reference/aspforaba_journal_example.lp
!examples/probabilistic/
